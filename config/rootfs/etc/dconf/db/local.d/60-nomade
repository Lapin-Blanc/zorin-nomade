# zorin-nomade (SPEC E-15, E-26) — base dconf système « local ».
# Nécessite un profil /etc/dconf/profile/user contenant « system-db:local » (absent du squashfs
# de Zorin 18.1 : à créer, voir docs/iso-notes.md), puis « dconf update » en chroot.

[org/gnome/software]
download-updates=false
download-updates-notify=false

# Tracker 3.7 (GNOME 46) : les noms de fichiers restent indexés (dossiers par défaut), pour que la
# recherche par nom de la vue d'ensemble et de Fichiers continue de fonctionner ; l'extraction du
# contenu des documents (texte intégral) est coupée. Voir DECISIONS.md D-020.
[org/freedesktop/tracker/miner/files]
index-removable-devices=false
index-optical-discs=false

[org/freedesktop/tracker/extract]
max-bytes=0
text-allowlist=@as []

[org/gnome/desktop/input-sources]
sources=[('xkb', 'be')]
