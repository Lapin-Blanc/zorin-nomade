# Paramètres du projet — sourcés par scripts/lib.sh (load_env).
# Surcharges locales éventuelles dans config/local.env (non versionné).
# shellcheck shell=bash disable=SC2034

PROJECT_NAME=zorin-nomade

# --- Système cible -----------------------------------------------------------
TARGET_HOSTNAME=zorin-nomade
TARGET_USER=fabien
TARGET_USER_FULLNAME="Fabien"
TARGET_LOCALE=fr_BE.UTF-8
TARGET_LANGUAGE=fr_BE:fr
TARGET_KEYMAP=be
TARGET_TIMEZONE=Europe/Brussels

# --- Image produite (en clair ; chiffrement au déploiement) --------------------
IMAGE_ESP_MIB=1024
IMAGE_BOOT_MIB=2048
IMAGE_ROOT_GIB=24          # agrandie au déploiement pour remplir la clé

# --- Déploiement --------------------------------------------------------------
DEPLOY_ENCRYPT=1           # 1 : racine en LUKS2 (clé de volume générée sur la cible)
DEPLOY_DATA_GIB=0          # > 0 : partition exFAT NOMADE-DATA en fin de clé
DEPLOY_TEST_SIZE_GIB=64    # taille du fichier creux utilisé par make deploy-test

# --- VM de build ----------------------------------------------------------------
BUILDER_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
BUILDER_SHA256SUMS_URL=https://cloud-images.ubuntu.com/noble/current/SHA256SUMS
BUILDER_CPUS=4
BUILDER_RAM_MB=3072        # hôte de Fabien : 7 Gio de RAM (voir DECISIONS.md D-016)
BUILDER_DISK_GB=100        # taille virtuelle (qcow2 creux)
BUILDER_SSH_PORT=2222
BUILDER_BOOT_TIMEOUT=300   # secondes

# --- Tests QEMU sur l'hôte -----------------------------------------------------
OVMF_CODE_SB=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
OVMF_VARS_SB=/usr/share/OVMF/OVMF_VARS_4M.ms.fd    # clés Microsoft, Secure Boot actif
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
TEST_RAM_MB=3072
TEST_CPUS=2
TEST_TIMEOUT=900           # secondes par essai

# --- Hôte ---------------------------------------------------------------------
MIN_FREE_GB=80
