# ISO Zorin OS — rempli en phase 0 (2026-11-07).
# ISO_SHA256 doit venir d'une source officielle Zorin (page de téléchargement ou d'aide) :
# note cette source dans ISO_SHA256_SOURCE.
# shellcheck shell=bash disable=SC2034

ISO_EDITION=Core
ISO_VERSION=18.1
# Miroir « World » de la page officielle https://zorin.com/os/download/18/core/
# (fichier du 2026-04-14, 3 909 091 328 octets). Autres miroirs listés sur la même page.
ISO_URL=https://mirrors.edge.kernel.org/zorinos-isos/18/Zorin-OS-18.1-Core-64-bit.iso
ISO_SHA256=44649b97bd307fc4c8529205d098ebbf98575a1e1ba2ee7d7005b697af1721d5
# « Zorin OS 18.1 Core 64-bit » dans la section « Correct SHA256 checksums » (page modifiée
# le 2026-04-18) ; identique au SHA256SUMS.txt du miroir kernel.org.
ISO_SHA256_SOURCE=https://help.zorin.com/docs/getting-started/check-the-integrity-of-your-copy-of-zorin-os/#correct-sha256-checksums
