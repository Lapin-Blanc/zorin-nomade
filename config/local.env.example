# Surcharges locales de config/project.env — exemple.
# Copier en config/local.env (non versionné), puis ne garder que les lignes à changer :
#   cp config/local.env.example config/local.env
# Lu par tous les scripts après project.env et iso.env. Aucun secret ici : la phrase de passe LUKS
# et le mot de passe du compte se tapent au déploiement.
# shellcheck shell=bash disable=SC2034

# --- Système cible (pris en compte au prochain make image) ----------------------
#TARGET_HOSTNAME=zorin-nomade
#TARGET_USER=prenom                 # identifiant du compte : minuscules, sans espace
#TARGET_USER_FULLNAME="Prénom Nom"
#TARGET_LOCALE=fr_FR.UTF-8
#TARGET_LANGUAGE=fr_FR:fr
#TARGET_KEYMAP=fr                   # disposition du clavier, initramfs compris (phrase LUKS)
#TARGET_TIMEZONE=Europe/Paris

# --- Déploiement (pris en compte au prochain make deploy) -----------------------
#DEPLOY_ENCRYPT=1                   # 0 : racine en clair
#DEPLOY_DATA_GIB=16                 # NOMADE-DATA (exFAT) : taille imposée ; 0 : aucune ; vide : 10 % de la clé

# --- Machine qui construit ------------------------------------------------------
#BUILDER_RAM_MB=4096                # VM de build ; 3072 suffit
#BUILDER_SSH_PORT=2223              # si le port 2222 est déjà pris
#TEST_RAM_MB=4096
#KEEP_IMAGES=2
